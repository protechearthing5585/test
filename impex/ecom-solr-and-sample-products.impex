# =============================================================================
# PLP 400 fix + sample Panametrics products
#
# Hybris log:
#   ConversionException: Missing solr facet search indexed catalog versions
#   at SearchSolrQueryPopulator.populate
#
# Store session catalogs are bhgeGlobalProductCatalog (see store.impex).
# Solr config bhgeIndex must include those versions or product search returns 400.
#
# After import: HAC -> Solr Facet Search -> bhgeIndex -> Index -> Full.
# =============================================================================

# --- 1) Solr search config: catalog versions that overlap the store session ----
UPDATE SolrFacetSearchConfig;name[unique=true];catalogVersions(catalog(id),version)[mode=append]
;bhgeIndex;bhgeGlobalProductCatalog:Online
;bhgeIndex;bhgeGlobalProductCatalog:Staged
;bhgeIndex;bhgeProductCatalog:Online
;bhgeIndex;bhgeProductCatalog:Staged
;bhgeIndex;ERP_CLASSIFICATION_HYB:ERP_IMPORT

UPDATE BaseSite;uid[unique=true];solrFacetSearchConfiguration(name)
;bhge;bhgeIndex

UPDATE BaseStore;uid[unique=true];solrFacetSearchConfiguration(name)
;bhge;bhgeIndex

# --- 2) Sample products on the global catalog (same catalog the store uses) ----
$catalog=bhgeGlobalProductCatalog
$staged=catalogVersion(catalog(id[default=$catalog]),version[default='Staged'])[unique=true,default=$catalog:Staged]
$online=catalogVersion(catalog(id[default=$catalog]),version[default='Online'])[unique=true,default=$catalog:Online]
$super=supercategories(code,catalogVersion(catalog(id),version))
$approved=approvalstatus(code)[default='approved']

INSERT_UPDATE Unit;code[unique=true];name[lang=en];unitType
;pieces;pieces;pieces

INSERT_UPDATE GEEdgeProduct;code[unique=true];$staged;name[lang=en];description[lang=en];$super;unit(code);$approved;hybrisStatus(code)[default='CATALOG'];productType(code)[default='PA']
