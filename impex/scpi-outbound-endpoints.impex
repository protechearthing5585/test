# Outbound Hybris -> SAP BTP Integration Suite (dev)
# Source: HybrisDS_Endpoint_Details (002).xlsx, sheet Outbound
# Host: https://is-dev-435v2e5y.it-cpi013-rt.cfapps.us21.hana.ondemand.com/http
# Import in HAC with legacy mode off. Restart is not required; the next SCPI call reads these rows.
#
# OAuth is still SCPI_CLOUDNEO_OAUTH_* in local.properties. The spreadsheet does not
# include the token URL or client id/secret. Those must be the credentials for this
# new tenant (role HybrisDSOAuthSend) or every call below returns 401.

INSERT_UPDATE BHGEGlobalProperties;uid[unique=true];value

