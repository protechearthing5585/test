# =============================================================================
# Guest / Panametrics category data (matches production OCC tree)
#
# Local GET /occ/v2/bhge/users/anonymous/ECOM_LVL0_00000000?guestSalesArea=1830_GE_GE
# returns {"categories":[]} because:
#   1) BHGEAnonymousUserCatalog is not linked to the live category items
#   2) The previous ImpEx created a tiny tree in the wrong catalog
# Production loads L1 ECOM_LVL1_00000002 (Panametrics) with L2 Flow / Process Analyzers
# from ClassificationClass in ERP_CLASSIFICATION_HYB:ERP_IMPORT.
#
# Import in HAC -> ImpEx Import. Then hard-refresh /panametrics.
# =============================================================================

# --- 1) Drop extra Category copies so getCategoryForCode stays unique ----------
REMOVE Category;code[unique=true];catalogVersion(catalog(id),version)[unique=true]
;ECOM_LVL0_00000000;bhgeContentCatalog:Online
;ECOM_LVL0_00000000;bhgeContentCatalog:Staged
;ECOM_LVL0_00000000;bhgeProductCatalog:Online
;ECOM_LVL0_00000000;bhgeProductCatalog:Staged
;ECOM_LVL0_00000000;bhgeGlobalProductCatalog:Online
;ECOM_LVL0_00000000;bhgeGlobalProductCatalog:Staged
;ECOM_LVL1_00000001;bhgeContentCatalog:Online
;ECOM_LVL1_00000001;bhgeContentCatalog:Staged
;ECOM_LVL1_00000001;bhgeProductCatalog:Online
;ECOM_LVL1_00000001;bhgeProductCatalog:Staged
;ECOM_LVL1_00000001;bhgeGlobalProductCatalog:Online
;ECOM_LVL1_00000001;bhgeGlobalProductCatalog:Staged
;ECOM_LVL1_00000002;bhgeContentCatalog:Online
;ECOM_LVL1_00000002;bhgeContentCatalog:Staged
;ECOM_LVL1_00000002;bhgeProductCatalog:Online
;ECOM_LVL1_00000002;bhgeProductCatalog:Staged
;ECOM_LVL1_00000002;bhgeGlobalProductCatalog:Online
;ECOM_LVL1_00000002;bhgeGlobalProductCatalog:Staged
;ECOM_LVL1_00000007;bhgeContentCatalog:Online
;ECOM_LVL1_00000007;bhgeContentCatalog:Staged
;ECOM_LVL1_00000007;bhgeProductCatalog:Online
;ECOM_LVL1_00000007;bhgeProductCatalog:Staged
;ECOM_LVL1_00000007;bhgeGlobalProductCatalog:Online
;ECOM_LVL1_00000007;bhgeGlobalProductCatalog:Staged
;ECOM_LVL2_00000001;bhgeContentCatalog:Online
;ECOM_LVL2_00000001;bhgeContentCatalog:Staged
;ECOM_LVL2_00000001;bhgeProductCatalog:Online
;ECOM_LVL2_00000001;bhgeProductCatalog:Staged
;ECOM_LVL2_00000001;bhgeGlobalProductCatalog:Online
;ECOM_LVL2_00000001;bhgeGlobalProductCatalog:Staged
;ECOM_LVL2_00000009;bhgeContentCatalog:Online
;ECOM_LVL2_00000009;bhgeContentCatalog:Staged
;ECOM_LVL2_00000009;bhgeProductCatalog:Online
;ECOM_LVL2_00000009;bhgeProductCatalog:Staged
;ECOM_LVL2_00000009;bhgeGlobalProductCatalog:Online
;ECOM_LVL2_00000009;bhgeGlobalProductCatalog:Staged
;ECOM_LVL2_00000010;bhgeContentCatalog:Online
;ECOM_LVL2_00000010;bhgeContentCatalog:Staged
;ECOM_LVL2_00000010;bhgeProductCatalog:Online
;ECOM_LVL2_00000010;bhgeProductCatalog:Staged
;ECOM_LVL2_00000010;bhgeGlobalProductCatalog:Online
;ECOM_LVL2_00000010;bhgeGlobalProductCatalog:Staged

# --- 2) Production tree lives on the ERP classification catalog ---------------
$erp=ERP_CLASSIFICATION_HYB
$erpCv=catalogversion(catalog(id[default=$erp]),version[default='ERP_IMPORT'])[unique=true,default=$erp:ERP_IMPORT]
$super=superCategories(code,$erpCv)

INSERT_UPDATE ClassificationClass;code[unique=true];name[lang=en];$super;$erpCv
;ECOM_LVL0_00000000;Products;;
;ECOM_LVL1_00000001;Inspection Technologies;ECOM_LVL0_00000000;
;ECOM_LVL1_00000002;Panametrics;ECOM_LVL0_00000000;
