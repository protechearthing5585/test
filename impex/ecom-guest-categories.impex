# --- 3) Guest store + anonymous catalog (this is what the OCC API reads) ------
UPDATE BaseStore;uid[unique=true];defaultCountry(isocode)
;bhge;US

INSERT_UPDATE BHGEGlobalProperties;uid[unique=true];value
;guestCategories;ECOM_LVL2_00000009,ECOM_LVL2_00000010,ECOM_LVL1_00000002

INSERT_UPDATE BHGEAnonymousUserCatalog;country(isocode)[unique=true];salesOrg[unique=true];distributionChannel[unique=true];division[unique=true];defaultSalesOrg;categories(code,catalogVersion(catalog(id),version))
;US;1800;GE;GE;true;ECOM_LVL1_00000001:ERP_CLASSIFICATION_HYB:ERP_IMPORT,ECOM_LVL1_00000002:ERP_CLASSIFICATION_HYB:ERP_IMPORT,ECOM_LVL1_00000006:ERP_CLASSIFICATION_HYB:ERP_IMPORT,ECOM_LVL1_00000009:ERP_CLASSIFICATION_HYB:ERP_IMPORT
