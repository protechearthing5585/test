;US;1200;BN;BN;false;ECOM_LVL1_00000006:ERP_CLASSIFICATION_HYB:ERP_IMPORT
;US;1600;RS;RS;false;ECOM_LVL1_00000009:ERP_CLASSIFICATION_HYB:ERP_IMPORT
;GB;6210;GE;GE;true;ECOM_LVL1_00000008:ERP_CLASSIFICATION_HYB:ERP_IMPORT

