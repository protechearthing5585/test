# =============================================================================
# PDP: "This product is not available for the region you are logged into."
#
# HAC -> Console -> ImpEx Import (legacy mode OFF). Then re-login.
# No Solr index is required for the PDP price / buy button.
#
# Buy is shown only when all of these are true
# (BHGEProductHybrisStatusStrategyImpl + getBuyAction):
#   1) GEEdgeCustomer.defaultSoldTo.ecommerceFlag is E1 or E2
#   2) defaultB2BUnit sales org matches a product BHGESalesAreaData row
#      with hybrisStatus SELL or SELLANDRETURN and materialStatus P1/P2/P3
#   3) PriceRow price > 0 (otherwise the action is CHECK_PRICE, and the
#      PDP template still shows the region message)
#
# Logged-in unit is 0000001830_1830_GE_GE. defaultSoldTo was empty, and
# neither 0000001830 nor 0000138305 had ecommerceFlag.
# DEW.IQ already has sales area 1830 / SELLANDRETURN / P1 and no USD price.
# =============================================================================

# --- 1) Sold-to must be allowed to buy (E1) -----------------------------------
UPDATE B2BUnit;uid[unique=true];ecommerceFlag
;0000001830;E1
;0000138305;E1
;0000251401;E1

# uid lookup, not email (stored emails differ by case).
UPDATE GEEdgeCustomer;uid[unique=true];defaultSoldTo(uid);defaultB2BUnit(uid)
;amira.mosley@bakerhughes.com;0000001830;0000001830_1830_GE_GE
;amy.beaudry@bakerhughes.com;0000251401;0000251401_1830_GE_GE

# --- 2) dew.IQ sales area for Panametrics (1830 / GE / GE) --------------------
# Existing uid is "DEW.IQ|1830" on bhgeGlobalProductCatalog:Online.
UPDATE BHGESalesAreaData;uid[unique=true];catalogVersion(catalog(id),version)[unique=true];hybrisStatus(code);materialStatus(code)
;DEW.IQ|1830;bhgeGlobalProductCatalog:Online;SELLANDRETURN;P1

# --- 3) USD list prices for every Online product that has none ----------------
$catalog=bhgeGlobalProductCatalog
$online=catalogVersion(catalog(id[default=$catalog]),version[default='Online'])[unique=true,default=$catalog:Online]

INSERT_UPDATE PriceRow;product(code,$online)[unique=true];currency(isocode)[unique=true];price;unit(code);net;minqtd;$online
